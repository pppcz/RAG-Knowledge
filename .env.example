# ============================================================
# ai-rag-knowledge-py 环境变量模板
# 复制为 .env 后按需修改；.env 永不提交
#   PowerShell: Copy-Item .env.example .env
# ============================================================

APP_NAME=ai-rag-knowledge-py
APP_ENV=dev
# 生产环境必须替换为随机长字符串（JWT 签名密钥，建议 >= 32 字节）
# 生成示例：python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# ---------------- 基础设施 ----------------
# 宿主 5432 已被占用，PostgreSQL 固定映射到 5433
DATABASE_URL=postgresql+psycopg://rag:rag@localhost:5433/rag
REDIS_URL=redis://localhost:6379/0

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=rag-docs
MINIO_SECURE=false

# 文件存储：minio（默认）或 local（离线降级，写入 LOCAL_STORAGE_DIR）
STORAGE_PROVIDER=minio
LOCAL_STORAGE_DIR=data/uploads
# 单个上传文件大小上限（MB）
MAX_UPLOAD_MB=20

# docker-compose 中 postgres / minio 容器的初始化凭据（仅本地开发）
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# 后端容器首次启动时是否自动创建默认租户/管理员（admin/123456，仅本地演示）
# 生产环境请设为 false
SEED_DEFAULT_DATA=true

# ---------------- LLM ----------------
# 方案 A（默认，零成本离线）：mock，返回预设文本，不调用任何外部 API
#   LLM_PROVIDER=mock
#   LLM_API_KEY=
# 方案 B（OpenRouter 免费模型，需 Key，限流约 20 次/分钟、50 次/天）
#   LLM_PROVIDER=openai_compatible
#   LLM_API_KEY=sk-or-v1-xxxx
LLM_PROVIDER=mock
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=deepseek/deepseek-v4-flash:free
LLM_TIMEOUT=60

# ---------------- Embedding ----------------
# 方案 A（默认，零成本离线）：hash，本地确定性哈希向量，只捕捉词汇重叠
#   EMBEDDING_PROVIDER=hash
# 方案 B（OpenAI 兼容 Embedding，需 Key）
#   EMBEDDING_PROVIDER=openai_compatible
#   EMBEDDING_BASE_URL=https://api.openai.com/v1
#   EMBEDDING_API_KEY=sk-xxxx
#   EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_PROVIDER=hash
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
# 必须与 pgvector 向量维度一致（vector(1536)）
EMBEDDING_DIM=1536

# ---------------- RAG 参数 ----------------
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=5
